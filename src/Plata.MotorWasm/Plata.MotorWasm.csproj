<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OpenSilverType>7</OpenSilverType>
    <DisableImplicitNamespaceImports>true</DisableImplicitNamespaceImports>
    <!-- Sin recorte: las apps se cargan dinámicamente, el recorte no las "ve". -->
    <PublishTrimmed>false</PublishTrimmed>
    <BlazorWebAssemblyEnableLinking>false</BlazorWebAssemblyEnableLinking>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="OpenSilver.WebAssembly" Version="$(PlataOpenSilverVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Plata.MotorApp\Plata.MotorApp.csproj" />
    <ProjectReference Include="..\Plata.Motor\Plata.Motor.csproj" />
  </ItemGroup>
</Project>
