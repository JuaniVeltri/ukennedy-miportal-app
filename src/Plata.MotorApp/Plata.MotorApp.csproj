<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DefineSilverlight>true</DefineSilverlight>
    <RootNamespace>Plata.MotorApp</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenSilver" Version="$(PlataOpenSilverVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </ApplicationDefinition>
    <Page Include="PantallaDePrueba.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="App.xaml.cs" />
    <Compile Include="PantallaDePrueba.xaml.cs" />
  </ItemGroup>
</Project>
